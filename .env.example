# 本檔只列 key 名稱與分類，不得填入任何實際值（通用規範 §3.4）。
# 有實際值的範本會被當成「可以直接複製的預設設定」，於是弱密碼與測試金鑰
# 會沿著 .env.example 一路被複製到正式環境，而且沒有任何檢查看得出來。

# --- 執行環境 ---
NODE_ENV=
PORT=

# --- 資料庫（MariaDB）---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# docker-compose.dev.yml 用來初始化本機開發容器的 root 密碼
DB_ROOT_PASSWORD=

# --- 認證（後端規範 §5.4）---
# access token 簽章金鑰
ACCESS_TOKEN_SECRET=
# access token 滑動視窗長度（秒），初始值 2 小時
ACCESS_TOKEN_TTL_SECONDS=
# refresh token 壽命（天），初始值 30 天；與上一項要一起調整，不可只改其中一個
REFRESH_TOKEN_TTL_DAYS=

# --- 欄位加密（後端規範 §5.1）---
# 敏感個資（身分證、生日、電話、Email、地址）的加密金鑰。
# 格式：`<金鑰代號>:<base64 的 32 位元組金鑰>`，逗號分隔可有多組。
# 多組的用途是日後輪替金鑰：一把 active（新資料用它加密）＋ 若干把舊金鑰（僅供解密舊資料）。
# 產生方式：openssl rand -base64 32
FIELD_ENCRYPTION_KEYS=
# 新資料一律用這個代號的金鑰加密；代號必須出現在 FIELD_ENCRYPTION_KEYS 內，否則拒絕啟動
FIELD_ENCRYPTION_ACTIVE_KEY_ID=
# blind index（identity_number_hash）專用金鑰，base64 的 32 位元組。
# **必須與上面每一把加密金鑰都不同**，相同即拒絕啟動：索引金鑰外洩只讓人能驗證「某個值在不在」，
# 加密金鑰外洩才是全部明文——共用一把等於把前者的風險升級成後者。
FIELD_BLIND_INDEX_KEY=

# --- 測試 ---
# §7.4：測試啟動時比對此值，連到非測試資料庫即中止
TEST_DB_NAME=
