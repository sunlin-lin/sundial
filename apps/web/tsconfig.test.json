{
  // 測試檔的型別檢查。
  //
  // 為什麼要獨立一份：tsconfig.json 把 `*.test.ts` 排除掉，這樣「正式建置要編譯的東西」
  // 與「只有測試才需要的東西」在設定上就是分開的兩包。少了這一份的話，測試檔會完全脫離
  // 型別檢查——測試照跑（Bun 直接執行 TypeScript，不做型別檢查），只是型別錯誤沒有人看得到，
  // 而一支型別已經對不上被測程式的測試，最常見的結局是它斷言了一個早就不存在的形狀。
  "extends": "./tsconfig.json",
  "include": ["src/**/*.ts", "src/**/*.vue", "env.d.ts"],
  // 必須明寫成空陣列：`exclude` 會從被繼承的設定沿用下來，
  // 不覆寫的話 tsconfig.json 那句「排除 `*.test.ts`」會原封不動地跟過來，
  // 於是這份專門檢查測試檔的設定會一支測試檔都檢查不到，而且看起來完全正常。
  "exclude": []
}
