{
  "name": "@sundial/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env run --watch src/index.ts",
    "db:generate": "bun --env-file=../../.env run drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env run drizzle-kit migrate",
    "db:migrate:test": "bun --env-file=../../.env --env-file=../../.env.test run drizzle-kit migrate",
    "seed:dev": "bun --env-file=../../.env run scripts/seed-dev.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.44.0",
    "elysia": "^1.3.0",
    "i18next": "^26.4.0",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "@elysiajs/openapi": "^1.4.0"
  }
}
